---
import Pagination from "@/components/Pagination.astro";
import { siteConfig } from "@/config/site";
import { postHref, type Post } from "@/lib/posts";

interface Props {
  feed: Post[];
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { feed, currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
---

<main id="content" class="outer">
  <div class="inner">
    <h1 class="sr-only">{siteConfig.name} — {siteConfig.tagline}</h1>

    <section class="title-feed-wrap" aria-label="文章">
      {feed.length > 0 ? (
        <ul class="title-feed">
          {feed.map((post) => (
            <li>
              <a href={postHref(post)} class="title-feed-link">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground">更多文章即将发布。</p>
      )}

      {lastPage > 1 && (
        <Pagination
          currentPage={currentPage}
          lastPage={lastPage}
          prevUrl={prevUrl}
          nextUrl={nextUrl}
          label="文章分页"
        />
      )}
    </section>
  </div>
</main>

<style>
  .title-feed-wrap {
    width: 100%;
    padding-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .title-feed-wrap {
      padding-top: 3.5rem;
    }
  }

  .title-feed {
    display: grid;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border) 55%, var(--background));
    border-radius: var(--radius-md);
  }

  .title-feed li {
    width: 100%;
  }

  .title-feed li:last-child .title-feed-link {
    border-bottom: 0;
  }

  .title-feed-link {
    display: block;
    width: 100%;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, var(--background));
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.75;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .title-feed-link:hover,
  .title-feed-link:focus-visible {
    color: var(--accent);
  }
</style>
