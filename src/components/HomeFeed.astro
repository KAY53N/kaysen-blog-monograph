---
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import Pagination from "@/components/Pagination.astro";
import PostCard from "@/components/PostCard.astro";
import { siteConfig } from "@/config/site";
import { categoryHref, getCategoryList, postsLabel, type Post } from "@/lib/posts";

interface Props {
  feed: Post[];
  allPosts: Post[];
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { feed, allPosts, currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
const categoryList = getCategoryList(allPosts);
---

<main id="content" class="outer">
  <div class="inner">
    <h1 class="sr-only">{siteConfig.name} — {siteConfig.tagline}</h1>

    <div class="grid gap-[var(--space-section)] pt-10 md:pt-14 lg:grid-cols-[minmax(0,4fr)_minmax(0,2fr)] lg:gap-12">
      <section aria-labelledby="more-posts">
        <h2 id="more-posts" class="section-title">文章</h2>

        {feed.length > 0 ? (
          <div class="feed">
            {feed.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <p class="text-muted-foreground">更多文章即将发布。</p>
        )}

        {lastPage > 1 && (
          <Pagination
            currentPage={currentPage}
            lastPage={lastPage}
            prevUrl={prevUrl}
            nextUrl={nextUrl}
            label="文章分页"
          />
        )}
      </section>

      <aside class="sidebar">
        <section aria-labelledby="about-heading">
          <h2 id="about-heading" class="section-title">关于</h2>
          <p class="text-lg font-semibold tracking-tight">{siteConfig.name}</p>
          <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">{siteConfig.about}</p>
          <div class="mt-7 border-t border-border pt-6">
            <NewsletterSignup />
          </div>
        </section>

        {categoryList.length > 0 && (
          <section aria-labelledby="categories-heading">
            <h2 id="categories-heading" class="section-title">分类</h2>
            <ul class="grid gap-4">
              {categoryList.map((category) => (
                <li>
                  <a href={categoryHref(category.name)} class="link-title flex items-center justify-between gap-3">
                    <span class="link-title__text text-base font-semibold tracking-tight">{category.name}</span>
                    <span class="pill shrink-0">{postsLabel(category.count)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </div>
</main>
