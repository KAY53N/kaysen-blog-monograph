<button type="button" class="back-to-top" data-back-to-top aria-label="返回顶部">
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
    <path d="M6 14.5 12 8.5l6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script>
  const button = document.querySelector("[data-back-to-top]");

  if (button instanceof HTMLButtonElement) {
    const toggle = () => {
      button.classList.toggle("is-visible", window.scrollY > 320);
    };

    toggle();
    window.addEventListener("scroll", toggle, { passive: true });
    button.addEventListener("click", () => {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    });
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    right: max(1rem, var(--gutter));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--card) 42%, transparent);
    color: var(--foreground);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    cursor: pointer;
    transform: translateY(0.4rem);
    transition:
      opacity var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out),
      background-color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out),
      visibility var(--duration) var(--ease-out);
  }

  .back-to-top.is-visible {
    opacity: 0.55;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    opacity: 0.92;
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    background: color-mix(in srgb, var(--card) 72%, transparent);
    color: var(--accent);
  }

  .back-to-top svg {
    width: 1.15rem;
    height: 1.15rem;
  }
</style>
