---
import { footerNavigation, siteConfig } from "@/config/site";

const currentYear = new Date().getFullYear();
---

<footer class="outer mt-[var(--space-section)] border-t border-border">
  <div class="inner grid gap-10 py-12 text-center md:grid-cols-3 md:items-center md:gap-8 md:text-left">
    <div>
      <a href="/" class="wordmark">{siteConfig.name}</a>
      <p class="mt-2 text-xs text-muted-foreground">&copy; {currentYear}. 保留所有权利。</p>
    </div>

    <nav aria-label="Footer navigation">
      <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        {
          footerNavigation.map((item, index) => (
            <li class="flex items-center gap-4">
              {index > 0 && <span class="footer-dot" aria-hidden="true" />}
              <a href={item.href} class="nav-link">{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="text-xs text-muted-foreground md:text-right">
      基于 <a href="https://astro.build/" rel="noreferrer" class="link-quiet underline underline-offset-2">Astro</a> 构建
    </p>
  </div>
</footer>

<style>
  .footer-dot {
    width: 2px;
    height: 2px;
    background: var(--border-strong);
    border-radius: 50%;
  }
</style>
