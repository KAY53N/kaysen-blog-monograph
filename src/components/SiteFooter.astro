---
import { footerNavigation, siteConfig } from "@/config/site";

const currentYear = new Date().getFullYear();
---

<footer class="outer mt-[var(--space-section)] border-t border-border">
  <div class="inner grid gap-10 py-12 text-center md:grid-cols-3 md:items-center md:gap-8 md:text-left">
    <div>
      <a href="/" class="wordmark">{siteConfig.name}</a>
      <p class="mt-2 text-xs text-muted-foreground">&copy; {currentYear}. 保留所有权利。</p>
    </div>

    <nav aria-label="Footer navigation">
      <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        {
          footerNavigation.map((item, index) => (
            <li class="flex items-center gap-4">
              {index > 0 && <span class="footer-dot" aria-hidden="true" />}
              <a href={item.href} class="nav-link">{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col items-center gap-2 text-xs text-muted-foreground md:items-end md:text-right">
      <p>
        基于 <a href="https://astro.build/" rel="noreferrer" class="link-quiet underline underline-offset-2">Astro</a> 构建
      </p>
      <p>
        <a
          href="https://dash.cloudflare.com"
          rel="noreferrer"
          class="footer-host link-quiet"
        >
          <svg class="footer-host-icon" viewBox="0 0 32 20" aria-hidden="true">
            <path
              fill="#FBAD41"
              d="M8.2 16.6h20.4c.8 0 1.5-.4 1.9-1.1.4-.7.4-1.5 0-2.2-.4-.7-1.1-1.1-1.9-1.1h-.3c.2-.6.2-1.2 0-1.8-.3-.9-1.1-1.6-2.1-1.8-.3-1.8-1.8-3.1-3.6-3.1-1.1 0-2.2.5-2.9 1.2C19.1 4.6 17.2 3.2 15 3.2c-2.6 0-4.8 1.8-5.4 4.3-1.6.2-3 1.6-3 3.4 0 .2 0 .5.1.7h1.5z"
            />
            <path
              fill="#F6821F"
              d="M6.6 16.6h17.3c.6 0 1.1-.3 1.4-.7.3-.5.3-1.1 0-1.6-.3-.5-.8-.7-1.4-.7h-.2c.2-.4.2-.9 0-1.3-.3-.7-.9-1.2-1.6-1.4L8.1 8.2c-.4-.1-.6-.4-.5-.8.1-.4.4-.6.8-.5l13.9 2.7c1.4.3 2.6 1.1 3.4 2.3.8 1.2.9 2.6.5 4-.7 2-2.5 3.4-4.7 3.4H5.7c-2 0-3.9-1.4-4.5-3.3-.6-1.9.1-4 1.7-5.2 1-.8 2.3-1.1 3.5-.9l.3 1.8c-.8-.1-1.7.2-2.4.7-1.1.8-1.5 2.1-1.1 3.4.4 1.2 1.6 2.1 2.9 2.1z"
            />
          </svg>
          由 Cloudflare 构建并托管
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-dot {
    width: 2px;
    height: 2px;
    background: var(--border-strong);
    border-radius: 50%;
  }

  .footer-host {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    text-underline-offset: 0.2em;
  }

  .footer-host:hover,
  .footer-host:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  .footer-host-icon {
    width: 1.05rem;
    height: 0.66rem;
    flex-shrink: 0;
  }
</style>
