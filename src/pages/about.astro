---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout
  title="关于"
  description={`关于 ${siteConfig.name}：这里写什么、由谁来写。`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">关于</p>
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="prose">
        <h2>这里会写什么</h2>
        <p>
          关于构建软件的长文笔记：一次改动背后的判断、付出的代价，以及下次会怎么做。文章按一次认真读完来写，而不是扫一眼。
        </p>

        <h2>怎么写</h2>
        <p>
          每篇文章都尽量可复现，并对取舍保持诚实。没做成的事情也会写进去。勘误会直接改在原文里，并在文首标出更新日期。
        </p>

        <h2>谁在写</h2>
        <ul>
          {
            authors.map((author) => (
              <li>
                <a href={`/author/${authorSlug(author.name)}/`}>{author.name}</a> — {author.role}（{author.posts.length} 篇）
              </li>
            ))
          }
        </ul>

        <h2>联系</h2>
        <p>
          问题、勘误和请求都欢迎通过 <a href="/contact/">联系页</a> 留言。
        </p>
        {
          siteConfig.email && (
            <p>也可以直接发邮件到 <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>。</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
