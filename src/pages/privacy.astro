---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="隐私" description={`${siteConfig.name} 的隐私政策。`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">隐私</p>
        <h1 class="pagehead-title">隐私政策</h1>
        <p class="pagehead-description">
          以下是站点可能收集的信息及用途说明。上线前请替换成你自己的政策。
        </p>
      </header>

      <div class="prose">
        <h2>收集哪些信息</h2>
        <p>
          本站为静态生成，自身不设置 Cookie。如果订阅或联系表单接入了第三方服务，你提交的内容会发给该服务。
        </p>

        <h2>如何使用</h2>
        <p>
          提交的信息只用于回复你，或发送你主动订阅的邮件。不会出售，也不会用于广告。
        </p>

        <h2>阅读偏好</h2>
        <p>
          你选择的浅色或深色模式会保存在浏览器的本地存储中，键名为
          <code>monograph-theme</code>。它不会离开你的设备，随时可以清除。
        </p>

        <h2>联系</h2>
        {
          siteConfig.email ? (
            <p>隐私相关请求请发邮件到 <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>。</p>
          ) : (
            <p>发布前请在 <code>src/config/site.ts</code> 中填写隐私联系邮箱。</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
