---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="页面不存在" description="你访问的页面找不到。" noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer grid min-h-[55vh] place-items-center py-16 text-center">
    <div>
      <p class="eyebrow">错误 404</p>
      <h1 class="pagehead-title">页面不存在</h1>
      <p class="pagehead-description mx-auto">
        这篇文章可能已经搬家，或者地址写错了。
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn btn-solid">回到首页</a>
        <a href="/posts/" class="btn btn-outline">浏览归档</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
