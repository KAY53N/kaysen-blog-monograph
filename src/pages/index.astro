---
import { getCollection } from "astro:content";
import HomeFeed from "@/components/HomeFeed.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { homePageSize, paginatePosts, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const page = paginatePosts(allPosts, homePageSize, 1);
---

<BaseLayout nextUrl={page.nextUrl}>
  <SiteHeader posts={allPosts} />
  <HomeFeed
    feed={page.data}
    allPosts={allPosts}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prevUrl={page.prevUrl}
    nextUrl={page.nextUrl}
  />
  <SiteFooter />
</BaseLayout>
