---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryDescriptions } from "@/config/categories";
import { siteConfig } from "@/config/site";
import { categoryHref, getCategoryList, postsLabel, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const categoryList = getCategoryList(allPosts);
---

<BaseLayout
  title="分类"
  description={`${siteConfig.name} 的全部分类及文章数量。`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">索引</p>
        <h1 class="pagehead-title">分类</h1>
        <p class="pagehead-description">
          共 {allPosts.length} 篇文章，归入 {categoryList.length} 个分类。
        </p>
      </header>

      <ul class="grid gap-7">
        {
          categoryList.map((category) => (
            <li class="border-b border-border pb-7 last:border-b-0">
              <a href={categoryHref(category.name)} class="link-title">
                <span class="flex items-baseline justify-between gap-4">
                  <span class="link-title__text text-xl font-semibold tracking-tight">{category.name}</span>
                  <span class="pill shrink-0">{postsLabel(category.count)}</span>
                </span>
                <span class="mt-2 block max-w-2xl text-pretty text-sm leading-relaxed text-muted-foreground">
                  {categoryDescriptions[category.name]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
